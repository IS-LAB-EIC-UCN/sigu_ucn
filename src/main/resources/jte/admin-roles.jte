@param String title
@param String usuarioNombre
@param java.util.List<cl.ucn.app.model.Rol> roles
@template.layout.main(administrador=true,title=title,usuarioNombre=usuarioNombre,content=@`
<section class="eventos-panel"><header class="eventos-cabecera"><div><p class="eyebrow">PERMISOS COMPARTIDOS</p><h1>Roles del sistema</h1><p>Asigna estos roles al crear o editar una cuenta. Sus nombres se conservan para todos los módulos.</p></div><a class="eventos-btn" href="/admin/usuarios">Administrar usuarios</a></header><div class="catalogos-grid">@for(var r:roles)<article class="catalogo"><span class="badge tema">${r.getNombre()}</span><h2>${"ADMIN".equals(r.getNombre()) ? "Administrador" : "DOCENTE".equals(r.getNombre()) ? "Organizador" : "Participante"}</h2><p>${"ADMIN".equals(r.getNombre()) ? "Administra cuentas, roles asignados, salas y categorías. Supervisa eventos ajenos publicados sin modificarlos. Puede organizar sus propios eventos." : "DOCENTE".equals(r.getNombre()) ? "Organiza sus eventos, gestiona expositores, consulta inscritos y registra la asistencia de sus participantes." : "Consulta, busca y filtra eventos. Se inscribe y puede cancelar su inscripción antes del inicio."}</p></article>@endfor</div></section>`)
