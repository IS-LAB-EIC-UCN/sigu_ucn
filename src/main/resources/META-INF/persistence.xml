<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             version="3.0"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="siguPU" transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Entidades Base y Grupo 1 -->
        <class>cl.ucn.app.model.Usuario</class>
        <class>cl.ucn.app.model.Rol</class>
        <class>cl.ucn.app.model.Espacio</class>
        <class>cl.ucn.app.model.Reserva</class>

        <!-- Entidades Grupo 2: Módulo de Biblioteca -->
        <class>cl.ucn.app.model.Bibliotecario</class>
        <class>cl.ucn.app.model.Lector</class>
        <class>cl.ucn.app.model.Categoria</class>
        <class>cl.ucn.app.model.Autor</class>
        <class>cl.ucn.app.model.Libro</class>
        <class>cl.ucn.app.model.Ejemplar</class>
        <class>cl.ucn.app.model.Prestamo</class>
        <class>cl.ucn.app.model.Multa</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/sigu_ucn"/>
            <property name="jakarta.persistence.jdbc.user" value="postgres"/>
            <property name="jakarta.persistence.jdbc.password" value="postgres"/>

            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>

    </persistence-unit>
</persistence>
